lcd "3"
lcd "ADRESSE"
lcd "A   3"
lcd "A   5"
lcd "PROG LOK?"
lcd "PROG"
lcd "3"
lcd "3"
lcd "CV LESEN"
lcd "PROG LOK?"
lcd "CV1"
lcd "CV8"
lcd "PROG"
lcd "CV8=13"
